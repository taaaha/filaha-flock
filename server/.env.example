# Copy to .env and fill. setup.sh generates strong defaults for you.
DB_USER=filaha
DB_PASSWORD=change-me-strong
DB_NAME=filaha

# MQTT credentials the API uses to subscribe (also created in mqtt/passwd by setup.sh)
MQTT_API_USER=server
MQTT_API_PASS=change-me-strong

# Bearer token the mobile app sends to the REST API (Authorization: Bearer <API_TOKEN>)
API_TOKEN=change-me-long-random

# Optional in-app push (NOT SMS) when the server sees a critical reading
EXPO_PUSH_ENABLED=false

# Watchdog: minutes of silence before a device is flagged offline (lost signal/power)
OFFLINE_AFTER_MIN=15
